{
  "name": "rota-server",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "dev:api": "tsx watch --env-file-if-exists=../.env src/api/main.ts",
    "dev:worker": "tsx watch --env-file-if-exists=../.env src/worker/main.ts",
    "start:api": "node --env-file-if-exists=../.env dist/api/main.js",
    "start:worker": "node --env-file-if-exists=../.env dist/worker/main.js",
    "test": "node --env-file-if-exists=../.env --import tsx --test \"src/**/*.unit.test.ts\" src/db/shard.test.ts",
    "test:unit": "node --env-file-if-exists=../.env --import tsx --test \"src/**/*.unit.test.ts\" src/db/shard.test.ts",
    "test:integration": "node --env-file-if-exists=../.env --import tsx --test --test-concurrency=1 \"src/**/*.integration.test.ts\"",
    "test:integration:slow": "node --env-file-if-exists=../.env --import tsx --test --test-concurrency=1 \"src/**/*.slow.test.ts\"",
    "test:all": "npm run test && npm run test:integration && npm run test:integration:slow",
    "db:deploy:a": "SHARD=a node --env-file-if-exists=../.env ./node_modules/prisma/build/index.js migrate deploy",
    "db:deploy:b": "SHARD=b node --env-file-if-exists=../.env ./node_modules/prisma/build/index.js migrate deploy",
    "db:deploy:test:a": "SHARD=test_a node --env-file-if-exists=../.env ./node_modules/prisma/build/index.js migrate deploy",
    "db:deploy:test:b": "SHARD=test_b node --env-file-if-exists=../.env ./node_modules/prisma/build/index.js migrate deploy",
    "db:status:a": "SHARD=a node --env-file-if-exists=../.env ./node_modules/prisma/build/index.js migrate status",
    "db:status:b": "SHARD=b node --env-file-if-exists=../.env ./node_modules/prisma/build/index.js migrate status",
    "db:status:test:a": "SHARD=test_a node --env-file-if-exists=../.env ./node_modules/prisma/build/index.js migrate status",
    "db:status:test:b": "SHARD=test_b node --env-file-if-exists=../.env ./node_modules/prisma/build/index.js migrate status",
    "db:parity": "tsx --env-file-if-exists=../.env src/db/parity.ts",
    "db:generate": "SHARD=a SHARD_A_DIRECT_URL=postgresql://unused:unused@localhost:5432/unused node ./node_modules/prisma/build/index.js generate",
    "db:feed-proof": "tsx --env-file-if-exists=../.env src/db/feed-proof.ts",
    "db:demo-swap": "tsx --env-file-if-exists=../.env src/db/demo-swap.ts",
    "db:check-pooled": "tsx --env-file-if-exists=../.env src/db/check-pooled.ts",
    "jobs:check-valkey": "tsx --env-file-if-exists=../.env src/jobs/scripts/check-valkey.ts",
    "jobs:prove:boxes-4-5": "tsx --env-file-if-exists=../.env src/jobs/scripts/prove-boxes-4-5.ts",
    "jobs:prove:crash": "tsx --env-file-if-exists=../.env src/jobs/scripts/prove-crash-recovery.ts",
    "prebuild": "npm run db:generate",
    "pretypecheck": "npm run db:generate",
    "pretest": "npm run db:generate",
    "predev:api": "npm run db:generate",
    "predev:worker": "npm run db:generate"
  },
  "dependencies": {
    "@node-rs/argon2": "2.2.2",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "bullmq": "6.3.17",
    "express": "5.3.0",
    "ioredis": "5.11.1",
    "jose": "6.2.12",
    "pg": "8.23.1",
    "stripe": "23.0.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "prisma": "7.10.1",
    "tsx": "4.23.15",
    "typescript": "6.0.3"
  }
}
