// Rota schema. The same schema and migrations are applied to BOTH shards (A, then B).
// The connection URL is chosen in prisma.config.ts (direct, unpooled URL for migrations).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum WorkStatus {
  pending
  claimed
  done
  failed

  @@map("work_status")
}

// Durable work rows (jobs.md). Postgres is the record; the Valkey queue is only a delivery mechanism.
// origin_request_id and payment_operation_id are deliberately omitted for now (ADR 0002).
model WorkRow {
  id                String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  kind              String
  status            WorkStatus @default(pending)
  generation        Int        @default(1)
  executionAttempts Int        @default(0) @map("execution_attempts")
  // Consecutive sweep recoveries of a pending row whose BullMQ job failed without the row ever being
  // claimed (ADR 0004). Incremented with the generation bump, reset to 0 by a successful claim. At
  // WORK_MAX_RECOVERIES the sweep marks the row failed. Not the attempt budget: attempts count claims.
  recoveryCount     Int        @default(0) @map("recovery_count")
  // Application code sets these explicitly (ADR 0002); the defaults are only a fallback.
  // Normal creation: available_at = run_at + 2 minutes. Enqueue failure: available_at = now().
  // The worker enforces run_at (claims need run_at <= now()); available_at is the sweep eligibility time.
  runAt             DateTime   @default(now()) @map("run_at") @db.Timestamptz(6)
  availableAt       DateTime   @default(now()) @map("available_at") @db.Timestamptz(6)
  claimToken        String?    @map("claim_token") @db.Uuid
  claimExpiresAt    DateTime?  @map("claim_expires_at") @db.Timestamptz(6)
  failureReason     String?    @map("failure_reason")

  // The request that created this work (observability.md). ADR 0002 deferred it until the first job started by a request: invitation email.
  originRequestId   String?    @map("origin_request_id") @db.Uuid

  // Email only (jobs.md, External effects).
  payload           Json?
  firstAttemptAt    DateTime?  @map("first_attempt_at") @db.Timestamptz(6)
  sentAt            DateTime?  @map("sent_at") @db.Timestamptz(6)
  providerMessageId String?    @map("provider_message_id")

  createdAt         DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  invitations Invitation[]
  authTokens  AuthToken[]

  // Timed sweep: pending rows past available_at; claimed rows with an expired lease.
  @@index([status, availableAt], map: "work_rows_status_available_at_idx")
  @@index([status, claimExpiresAt], map: "work_rows_status_claim_expires_at_idx")
  @@map("work_rows")
}

// ---- Identity (shard A only in practice; the same migrations run on both shards, data.md) ----
// users, credentials and refresh-token records live on shard A. Reads always use the primary.

model User {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  // Stored trimmed and lowercased by the application; the unique index makes registration atomic.
  email           String    @unique
  name            String
  // NULL = unverified. Signup verification is deferred (security.md).
  emailVerifiedAt DateTime? @map("email_verified_at") @db.Timestamptz(6)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  credential Credential?
  families   RefreshTokenFamily[]
  userTeams  UserTeam[]
  authTokens AuthToken[]

  @@map("users")
}

model Credential {
  userId       String   @id @map("user_id") @db.Uuid
  // Argon2id PHC string. Never logged, never returned.
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("credentials")
}

// One row per device login. The family is the "session": the access token carries its ID and every
// authenticated request checks it. Revoking the family revokes every token in it (ADR 0005).
model RefreshTokenFamily {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId            String    @map("user_id") @db.Uuid
  absoluteExpiresAt DateTime  @map("absolute_expires_at") @db.Timestamptz(6)
  revokedAt         DateTime? @map("revoked_at") @db.Timestamptz(6)
  // logout | logout_all | reuse_detected | password_reset | address_verified (a magic link verified an address that was unverified)
  revokedReason     String?   @map("revoked_reason")
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user   User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokens RefreshToken[]

  @@index([userId], map: "refresh_token_families_user_id_idx")
  @@map("refresh_token_families")
}

model RefreshToken {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  familyId      String    @map("family_id") @db.Uuid
  // SHA-256 of the opaque token. The token itself is never stored.
  tokenHash     Bytes     @unique @map("token_hash")
  idleExpiresAt DateTime  @map("idle_expires_at") @db.Timestamptz(6)
  usedAt        DateTime? @map("used_at") @db.Timestamptz(6)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  family RefreshTokenFamily @relation(fields: [familyId], references: [id], onDelete: Cascade)

  @@index([familyId], map: "refresh_tokens_family_id_idx")
  @@map("refresh_tokens")
}

// ---- Teams (team-owned, on the shard picked by the hash of team_id; the same migrations run on both shards) ----

enum TeamRole {
  owner
  manager
  staff

  @@map("team_role")
}

model Team {
  // No database default: the server generates team_id BEFORE the first insert, because the shard is chosen from it (data.md).
  id        String   @id @db.Uuid
  name      String
  // IANA time zone name, validated by the server against the runtime's list.
  timeZone  String   @map("time_zone")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  memberships Membership[]
  invitations Invitation[]
  shifts      Shift[]
  activity    Activity[]

  @@map("teams")
}

// The authoritative record of who is in a team and in which role. Roles are read from here on every request, never from a token.
// user_id points at a user on shard A, so there is deliberately no foreign key (data.md).
// Also in the SQL, which Prisma cannot express: a partial unique index "memberships_one_owner_per_team" on (team_id) WHERE role = 'owner'.
model Membership {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  teamId    String   @map("team_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  role      TeamRole
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId], map: "memberships_team_id_user_id_key")
  @@map("memberships")
}

// The user-to-teams directory (ADR 0013). Shard A in practice. A lookup hint, never proof of membership: it may over-report
// but must never under-report, so a membership is written AFTER its row here and removed BEFORE it. Reads verify against the
// team's shard. team_id is on another shard, so no foreign key.
model UserTeam {
  userId    String   @map("user_id") @db.Uuid
  teamId    String   @map("team_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, teamId])
  @@map("user_teams")
}

// An email invitation to join a team in a role. Team-owned: lives on the team's shard. Only the SHA-256 of the secret is stored; the raw
// secret exists in the link and, until the email job finishes, in the frozen work-row payload (ADR 0015, ADR 0016). A resend rotates
// token_hash and expires_at on the same row. user ids point at shard A, so there is no foreign key (data.md).
// Also in the SQL, which Prisma cannot express: CHECK "invitations_role_not_owner" (role <> 'owner'), CHECK "invitations_email_normalised"
// (email = lower(btrim(email))), and the partial unique index
// "invitations_one_pending_per_email" on (team_id, email) WHERE accepted_at IS NULL AND revoked_at IS NULL.
model Invitation {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  teamId            String    @map("team_id") @db.Uuid
  // Stored trimmed and lowercased by the application; the database refuses anything else (CHECK).
  email             String
  role              TeamRole
  tokenHash         Bytes     @unique @map("token_hash")
  expiresAt         DateTime  @map("expires_at") @db.Timestamptz(6)
  invitedByUserId   String    @map("invited_by_user_id") @db.Uuid
  acceptedAt        DateTime? @map("accepted_at") @db.Timestamptz(6)
  acceptedByUserId  String?   @map("accepted_by_user_id") @db.Uuid
  revokedAt         DateTime? @map("revoked_at") @db.Timestamptz(6)
  // The latest email work row (a resend moves it). The pending list reads its state: queued, sent, or email not sent.
  emailWorkRowId    String?   @map("email_work_row_id") @db.Uuid
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  team         Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  emailWorkRow WorkRow? @relation(fields: [emailWorkRowId], references: [id], onDelete: SetNull)

  @@map("invitations")
}

// ---- Password reset and magic link (identity data: shard A only, like users; the same migrations run on both shards) ----

enum AuthTokenPurpose {
  magic_link
  password_reset

  @@map("auth_token_purpose")
}

// One emailed, single-use, expiring token (security.md). Only the SHA-256 of the secret is stored; the secret exists only in the link inside the
// frozen email payload until the email job has sent or skipped it. `used_at` is set by redemption, and also when a newer request replaces an
// older unused token, or when a reset succeeds (every outstanding token of that user dies).
model AuthToken {
  id             String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId         String           @map("user_id") @db.Uuid
  purpose        AuthTokenPurpose
  tokenHash      Bytes            @unique @map("token_hash")
  expiresAt      DateTime         @map("expires_at") @db.Timestamptz(6)
  usedAt         DateTime?        @map("used_at") @db.Timestamptz(6)
  // The email work row (written in the same transaction on shard A). The email job skips a send whose token is used or expired.
  emailWorkRowId String?          @map("email_work_row_id") @db.Uuid
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  emailWorkRow WorkRow? @relation(fields: [emailWorkRowId], references: [id], onDelete: SetNull)

  @@index([userId, purpose], map: "auth_tokens_user_id_purpose_idx")
  @@map("auth_tokens")
}

// ---- Shifts and activity (team-owned: they live on the team's shard, written in one transaction) ----

enum ActivityKind {
  shift_created
  shift_updated
  shift_deleted

  @@map("activity_kind")
}

// One scheduled shift. Times are UTC instants at millisecond precision (timestamptz(3)), so a JavaScript Date and the database agree to the last
// digit and a cursor built from created_at never loses a tie (ADR 0022). assigned_user_id points at a user on shard A, so there is deliberately no
// foreign key (data.md); the server checks the person is a member of this team. NULL means an open shift. Also in the SQL, which Prisma cannot express:
// CHECK "shifts_ends_after_starts" (ends_at > starts_at) and CHECK "shifts_break_not_negative".
model Shift {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  teamId          String    @map("team_id") @db.Uuid
  title           String
  area            String?
  startsAt        DateTime  @map("starts_at") @db.Timestamptz(3)
  endsAt          DateTime  @map("ends_at") @db.Timestamptz(3)
  breakMinutes    Int?      @map("break_minutes")
  note            String?
  assignedUserId  String?   @map("assigned_user_id") @db.Uuid
  createdByUserId String    @map("created_by_user_id") @db.Uuid
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@index([teamId, startsAt], map: "shifts_team_id_starts_at_idx")
  @@index([teamId, assignedUserId, startsAt], map: "shifts_team_id_assigned_user_id_starts_at_idx")
  @@map("shifts")
}

// The team's activity record: one row per change, written in the SAME transaction as the change. Append-only by convention (nothing updates or
// deletes a row). shift_id has no foreign key on purpose: a deleted shift's history must outlive it. `data` holds a small snapshot (the title,
// the times, who) so the feed needs no join. The feed's own index arrives with the feed (ADR 0022), after the "before" query plan is recorded.
model Activity {
  id          String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  teamId      String       @map("team_id") @db.Uuid
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  actorUserId String       @map("actor_user_id") @db.Uuid
  kind        ActivityKind
  shiftId     String?      @map("shift_id") @db.Uuid
  data        Json         @default("{}")

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  // The feed's index (ADR 0022): filter by team, newest first, `id` as the tiebreak. Added AFTER the before-plan was recorded.
  @@index([teamId, createdAt(sort: Desc), id(sort: Desc)])
  @@map("activity")
}
