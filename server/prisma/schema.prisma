// Rota schema. The same schema and migrations are applied to BOTH shards (A, then B).
// The connection URL is chosen in prisma.config.ts (direct, unpooled URL for migrations).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum WorkStatus {
  pending
  claimed
  done
  failed

  @@map("work_status")
}

// Durable work rows (jobs.md). Postgres is the record; the Valkey queue is only a delivery mechanism.
// origin_request_id and payment_operation_id are deliberately omitted for now (ADR 0002).
model WorkRow {
  id                String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  kind              String
  status            WorkStatus @default(pending)
  generation        Int        @default(1)
  executionAttempts Int        @default(0) @map("execution_attempts")
  // Consecutive sweep recoveries of a pending row whose BullMQ job failed without the row ever being
  // claimed (ADR 0004). Incremented with the generation bump, reset to 0 by a successful claim. At
  // WORK_MAX_RECOVERIES the sweep marks the row failed. Not the attempt budget: attempts count claims.
  recoveryCount     Int        @default(0) @map("recovery_count")
  // Application code sets these explicitly (ADR 0002); the defaults are only a fallback.
  // Normal creation: available_at = run_at + 2 minutes. Enqueue failure: available_at = now().
  // The worker enforces run_at (claims need run_at <= now()); available_at is the sweep eligibility time.
  runAt             DateTime   @default(now()) @map("run_at") @db.Timestamptz(6)
  availableAt       DateTime   @default(now()) @map("available_at") @db.Timestamptz(6)
  claimToken        String?    @map("claim_token") @db.Uuid
  claimExpiresAt    DateTime?  @map("claim_expires_at") @db.Timestamptz(6)
  failureReason     String?    @map("failure_reason")

  // The request that created this work (observability.md). ADR 0002 deferred it until the first job started by a request: invitation email.
  originRequestId   String?    @map("origin_request_id") @db.Uuid

  // Email only (jobs.md, External effects).
  payload           Json?
  firstAttemptAt    DateTime?  @map("first_attempt_at") @db.Timestamptz(6)
  sentAt            DateTime?  @map("sent_at") @db.Timestamptz(6)
  providerMessageId String?    @map("provider_message_id")

  createdAt         DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  invitations  Invitation[]
  authTokens   AuthToken[]
  stripeEvents StripeEvent[]

  // Timed sweep: pending rows past available_at; claimed rows with an expired lease.
  @@index([status, availableAt], map: "work_rows_status_available_at_idx")
  @@index([status, claimExpiresAt], map: "work_rows_status_claim_expires_at_idx")
  @@map("work_rows")
}

// ---- Identity (shard A only in practice; the same migrations run on both shards, data.md) ----
// users, credentials and refresh-token records live on shard A. Reads always use the primary.

model User {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  // Stored trimmed and lowercased by the application; the unique index makes registration atomic.
  email           String    @unique
  name            String
  // NULL = unverified. Signup verification is deferred (security.md).
  emailVerifiedAt DateTime? @map("email_verified_at") @db.Timestamptz(6)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  credential Credential?
  families   RefreshTokenFamily[]
  userTeams  UserTeam[]
  authTokens AuthToken[]
  settings   UserSettings?

  @@map("users")
}

model Credential {
  userId       String   @id @map("user_id") @db.Uuid
  // Argon2id PHC string. Never logged, never returned.
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("credentials")
}

// One row per device login. The family is the "session": the access token carries its ID and every
// authenticated request checks it. Revoking the family revokes every token in it (ADR 0005).
model RefreshTokenFamily {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId            String    @map("user_id") @db.Uuid
  absoluteExpiresAt DateTime  @map("absolute_expires_at") @db.Timestamptz(6)
  revokedAt         DateTime? @map("revoked_at") @db.Timestamptz(6)
  // logout | logout_all | reuse_detected | password_reset | address_verified (a magic link verified an address that was unverified)
  revokedReason     String?   @map("revoked_reason")
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user   User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokens RefreshToken[]

  @@index([userId], map: "refresh_token_families_user_id_idx")
  @@map("refresh_token_families")
}

model RefreshToken {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  familyId      String    @map("family_id") @db.Uuid
  // SHA-256 of the opaque token. The token itself is never stored.
  tokenHash     Bytes     @unique @map("token_hash")
  idleExpiresAt DateTime  @map("idle_expires_at") @db.Timestamptz(6)
  usedAt        DateTime? @map("used_at") @db.Timestamptz(6)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  family RefreshTokenFamily @relation(fields: [familyId], references: [id], onDelete: Cascade)

  @@index([familyId], map: "refresh_tokens_family_id_idx")
  @@map("refresh_tokens")
}

// ---- Teams (team-owned, on the shard picked by the hash of team_id; the same migrations run on both shards) ----

enum TeamRole {
  owner
  manager
  staff

  @@map("team_role")
}

model Team {
  // No database default: the server generates team_id BEFORE the first insert, because the shard is chosen from it (data.md).
  id        String   @id @db.Uuid
  name      String
  // IANA time zone name, validated by the server against the runtime's list.
  timeZone  String   @map("time_zone")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  memberships Membership[]
  invitations Invitation[]
  shifts      Shift[]
  activity    Activity[]
  swapRequests SwapRequest[]

  @@map("teams")
}

// The authoritative record of who is in a team and in which role. Roles are read from here on every request, never from a token.
// user_id points at a user on shard A, so there is deliberately no foreign key (data.md).
// Also in the SQL, which Prisma cannot express: a partial unique index "memberships_one_owner_per_team" on (team_id) WHERE role = 'owner'.
model Membership {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  teamId    String   @map("team_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  role      TeamRole
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId], map: "memberships_team_id_user_id_key")
  @@map("memberships")
}

// The user-to-teams directory (ADR 0013). Shard A in practice. A lookup hint, never proof of membership: it may over-report
// but must never under-report, so a membership is written AFTER its row here and removed BEFORE it. Reads verify against the
// team's shard. team_id is on another shard, so no foreign key.
model UserTeam {
  userId    String   @map("user_id") @db.Uuid
  teamId    String   @map("team_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, teamId])
  @@map("user_teams")
}

// Email invitations or invite links (ADR 0025): `kind` says which. A link has no email, is Staff only, and is single use like every invitation.
enum InvitationKind {
  email
  link

  @@map("invitation_kind")
}

// An invitation to join a team in a role (an email invitation, or a shareable link, see `kind`). Team-owned: lives on the team's shard. Only the SHA-256 of the secret is stored; the raw
// secret exists in the link and, until the email job finishes, in the frozen work-row payload (ADR 0015, ADR 0016). A resend rotates
// token_hash and expires_at on the same row. user ids point at shard A, so there is no foreign key (data.md).
// Also in the SQL, which Prisma cannot express: CHECK "invitations_role_not_owner" (role <> 'owner'), CHECK "invitations_email_normalised"
// (email = lower(btrim(email))), and the partial unique index
// "invitations_one_pending_per_email" on (team_id, email) WHERE accepted_at IS NULL AND revoked_at IS NULL, and, for links (ADR 0025), CHECK
// "invitations_kind_email_match" (an email invitation has an address, a link has none) and CHECK "invitations_link_staff_only".
model Invitation {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  teamId            String    @map("team_id") @db.Uuid
  // Stored trimmed and lowercased by the application; the database refuses anything else (CHECK). NULL for a link.
  email             String?
  kind              InvitationKind @default(email)
  role              TeamRole
  tokenHash         Bytes     @unique @map("token_hash")
  expiresAt         DateTime  @map("expires_at") @db.Timestamptz(6)
  invitedByUserId   String    @map("invited_by_user_id") @db.Uuid
  acceptedAt        DateTime? @map("accepted_at") @db.Timestamptz(6)
  acceptedByUserId  String?   @map("accepted_by_user_id") @db.Uuid
  revokedAt         DateTime? @map("revoked_at") @db.Timestamptz(6)
  // The latest email work row (a resend moves it). The pending list reads its state: queued, sent, or email not sent.
  emailWorkRowId    String?   @map("email_work_row_id") @db.Uuid
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  team         Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  emailWorkRow WorkRow? @relation(fields: [emailWorkRowId], references: [id], onDelete: SetNull)

  @@map("invitations")
}

// ---- Password reset and magic link (identity data: shard A only, like users; the same migrations run on both shards) ----

enum AuthTokenPurpose {
  magic_link
  password_reset

  @@map("auth_token_purpose")
}

// One emailed, single-use, expiring token (security.md). Only the SHA-256 of the secret is stored; the secret exists only in the link inside the
// frozen email payload until the email job has sent or skipped it. `used_at` is set by redemption, and also when a newer request replaces an
// older unused token, or when a reset succeeds (every outstanding token of that user dies).
model AuthToken {
  id             String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId         String           @map("user_id") @db.Uuid
  purpose        AuthTokenPurpose
  tokenHash      Bytes            @unique @map("token_hash")
  expiresAt      DateTime         @map("expires_at") @db.Timestamptz(6)
  usedAt         DateTime?        @map("used_at") @db.Timestamptz(6)
  // The email work row (written in the same transaction on shard A). The email job skips a send whose token is used or expired.
  emailWorkRowId String?          @map("email_work_row_id") @db.Uuid
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  emailWorkRow WorkRow? @relation(fields: [emailWorkRowId], references: [id], onDelete: SetNull)

  @@index([userId, purpose], map: "auth_tokens_user_id_purpose_idx")
  @@map("auth_tokens")
}

// ---- User settings (identity data: shard A only, like users; the same migrations run on both shards; ADR 0024) ----

// One row per user, created by the first change. Every setting has its own *_updated_at, stamped by the DATABASE clock on arrival (never the client's):
// the most recent change wins, per field. NULL = never changed. The API reads and writes this table with raw SQL so that `NOW()` is the stamp.
// Also in the SQL, which Prisma cannot express: CHECK "user_settings_theme_known" and CHECK "user_settings_quiet_hours_window" (start <> end).
model UserSettings {
  userId                       String    @id @map("user_id") @db.Uuid
  quietHoursEnabled            Boolean   @default(false) @map("quiet_hours_enabled")
  quietHoursStart              DateTime  @default(dbgenerated("'22:00:00'::time without time zone")) @map("quiet_hours_start") @db.Time(0)
  quietHoursEnd                DateTime  @default(dbgenerated("'06:00:00'::time without time zone")) @map("quiet_hours_end") @db.Time(0)
  quietHoursUpdatedAt          DateTime? @map("quiet_hours_updated_at") @db.Timestamptz(3)
  timeZone                     String?   @map("time_zone")
  timeZoneUpdatedAt            DateTime? @map("time_zone_updated_at") @db.Timestamptz(3)
  notifyShiftChanges           Boolean   @default(true) @map("notify_shift_changes")
  notifyShiftChangesUpdatedAt  DateTime? @map("notify_shift_changes_updated_at") @db.Timestamptz(3)
  notifySwapUpdates            Boolean   @default(true) @map("notify_swap_updates")
  notifySwapUpdatesUpdatedAt   DateTime? @map("notify_swap_updates_updated_at") @db.Timestamptz(3)
  notifyBilling                Boolean   @default(true) @map("notify_billing")
  notifyBillingUpdatedAt       DateTime? @map("notify_billing_updated_at") @db.Timestamptz(3)
  language                     String    @default("en")
  languageUpdatedAt            DateTime? @map("language_updated_at") @db.Timestamptz(3)
  theme                        String    @default("system")
  themeUpdatedAt               DateTime? @map("theme_updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_settings")
}

// ---- Shifts and activity (team-owned: they live on the team's shard, written in one transaction) ----

enum ActivityKind {
  shift_created
  shift_updated
  shift_deleted
  swap_requested
  swap_approved
  swap_rejected

  @@map("activity_kind")
}

// One scheduled shift. Times are UTC instants at millisecond precision (timestamptz(3)), so a JavaScript Date and the database agree to the last
// digit and a cursor built from created_at never loses a tie (ADR 0022). assigned_user_id points at a user on shard A, so there is deliberately no
// foreign key (data.md); the server checks the person is a member of this team. NULL means an open shift. Also in the SQL, which Prisma cannot express:
// CHECK "shifts_ends_after_starts" (ends_at > starts_at) and CHECK "shifts_break_not_negative".
model Shift {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  teamId          String    @map("team_id") @db.Uuid
  title           String
  area            String?
  startsAt        DateTime  @map("starts_at") @db.Timestamptz(3)
  endsAt          DateTime  @map("ends_at") @db.Timestamptz(3)
  breakMinutes    Int?      @map("break_minutes")
  note            String?
  assignedUserId  String?   @map("assigned_user_id") @db.Uuid
  createdByUserId String    @map("created_by_user_id") @db.Uuid
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@index([teamId, startsAt], map: "shifts_team_id_starts_at_idx")
  @@index([teamId, assignedUserId, startsAt], map: "shifts_team_id_assigned_user_id_starts_at_idx")
  @@map("shifts")
}

// The team's activity record: one row per change, written in the SAME transaction as the change. Append-only by convention (nothing updates or
// deletes a row). shift_id has no foreign key on purpose: a deleted shift's history must outlive it. `data` holds a small snapshot (the title,
// the times, who) so the feed needs no join. The feed's own index arrives with the feed (ADR 0022), after the "before" query plan is recorded.
model Activity {
  id          String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  teamId      String       @map("team_id") @db.Uuid
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  actorUserId String       @map("actor_user_id") @db.Uuid
  kind        ActivityKind
  shiftId     String?      @map("shift_id") @db.Uuid
  data        Json         @default("{}")

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  // The feed's index (ADR 0022): filter by team, newest first, `id` as the tiebreak. Added AFTER the before-plan was recorded.
  @@index([teamId, createdAt(sort: Desc), id(sort: Desc)])
  @@map("activity")
}

// ---- Swaps (team-owned, ADR 0023) ----

enum SwapStatus {
  pending
  approved
  rejected
  cancelled

  @@map("swap_status")
}

// A request to exchange two shifts: the requester's own shift (`offered`) for a teammate's (`requested`). A manager decides. Shifts and users are not
// foreign keys (shifts can be deleted, users live on shard A); the approval re-checks everything against the live rows. `snapshot` keeps what both shifts
// looked like when it was requested, so the request still reads correctly after the shifts have changed hands.
model SwapRequest {
  id                 String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  teamId             String     @map("team_id") @db.Uuid
  requesterUserId    String     @map("requester_user_id") @db.Uuid
  counterpartyUserId String     @map("counterparty_user_id") @db.Uuid
  offeredShiftId     String     @map("offered_shift_id") @db.Uuid
  requestedShiftId   String     @map("requested_shift_id") @db.Uuid
  // The app's key for this one request: a repeat of it (a retry after a timeout) returns the stored request instead of creating a second.
  idempotencyKey     String     @map("idempotency_key")
  status             SwapStatus @default(pending)
  snapshot           Json
  decidedByUserId    String?    @map("decided_by_user_id") @db.Uuid
  decidedAt          DateTime?  @map("decided_at") @db.Timestamptz(3)
  createdAt          DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([teamId, requesterUserId, idempotencyKey], map: "swap_requests_team_requester_key_key")
  @@index([teamId, status, createdAt(sort: Desc)], map: "swap_requests_team_status_created_idx")
  @@index([teamId, requesterUserId, status], map: "swap_requests_team_requester_status_idx")
  @@map("swap_requests")
}

// ---- Billing (ADR 0026; money.md). The same migration runs on both shards: the team tables live on the team's shard, stripe_events on shard A. ----
// Integer cents only. There is deliberately NO foreign key from a billing table to "teams": a team's money history outlives the team, and the ledger is never deleted.
// Also in the SQL, which Prisma cannot express: CHECKs on every table (seat and amount rules, kind shapes), the partial unique index
// "payment_operations_one_open_per_team" on (team_id) WHERE status = 'open', the partial index "stripe_events_unprocessed_idx", and the append-only triggers on ledger_entries.

enum BillingPlan {
  starter
  team
  business

  @@map("billing_plan")
}

enum LedgerEntryType {
  period_start
  entitlement_change
  charge
  credit
  refund
  correction

  @@map("ledger_entry_type")
}

enum PaymentOperationKind {
  activation
  change

  @@map("payment_operation_kind")
}

enum PaymentOperationStatus {
  open
  completed
  expired
  failed
  needs_review

  @@map("payment_operation_status")
}

// One billing period: [starts_on, ends_on) in UTC calendar days. period_days (28 to 31) is the length every calculation reads.
model BillingPeriod {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  teamId     String   @map("team_id") @db.Uuid
  startsOn   DateTime @map("starts_on") @db.Date
  endsOn     DateTime @map("ends_on") @db.Date
  periodDays Int      @map("period_days")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  subscriptions     Subscription[]
  paymentOperations PaymentOperation[]
  ledgerEntries     LedgerEntry[]

  @@unique([teamId, startsOn], map: "billing_periods_team_id_starts_on_key")
  @@map("billing_periods")
}

// The current state of a team's subscription: a projection of the ledger, never its source (rebuildable from it). No row = not activated.
model Subscription {
  teamId           String      @id @map("team_id") @db.Uuid
  plan             BillingPlan
  seats            Int
  billingAnchorDay Int         @map("billing_anchor_day")
  // What the current period has been paid at; not always the entitlements' amount (a cheaper upgrade leaves it higher).
  paidBasisCents   Int         @map("paid_basis_cents")
  version          Int
  currentPeriodId  String      @map("current_period_id") @db.Uuid
  activatedAt      DateTime    @map("activated_at") @db.Timestamptz(3)
  updatedAt        DateTime    @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  currentPeriod BillingPeriod @relation(fields: [currentPeriodId], references: [id], onDelete: Restrict)

  @@map("subscriptions")
}

// A paid change, frozen: its base version, target, period, calculation and quote. Stripe metadata carries team_id and this id.
model PaymentOperation {
  id                      String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  teamId                  String                 @map("team_id") @db.Uuid
  kind                    PaymentOperationKind
  requestedByUserId       String                 @map("requested_by_user_id") @db.Uuid
  baseVersion             Int                    @map("base_version")
  periodId                String?                @map("period_id") @db.Uuid
  activationDate          DateTime?              @map("activation_date") @db.Date
  fromPlan                BillingPlan?           @map("from_plan")
  fromSeats               Int?                   @map("from_seats")
  applyPlan               BillingPlan            @map("apply_plan")
  applySeats              Int                    @map("apply_seats")
  scheduledPlan           BillingPlan?           @map("scheduled_plan")
  scheduledSeats          Int?                   @map("scheduled_seats")
  periodDays              Int                    @map("period_days")
  remainingDays           Int                    @map("remaining_days")
  paidBasisBeforeCents    Int                    @map("paid_basis_before_cents")
  grossChargeCents        Int                    @map("gross_charge_cents")
  creditCents             Int                    @map("credit_cents")
  quoteCents              Int                    @map("quote_cents")
  paidBasisAfterCents     Int                    @map("paid_basis_after_cents")
  currency                String                 @default("usd")
  status                  PaymentOperationStatus @default(open)
  stripeCheckoutSessionId String?                @unique @map("stripe_checkout_session_id")
  stripePaymentIntentId   String?                @unique @map("stripe_payment_intent_id")
  expiresAt               DateTime               @map("expires_at") @db.Timestamptz(3)
  completedAt             DateTime?              @map("completed_at") @db.Timestamptz(3)
  reviewReason            String?                @map("review_reason")
  createdAt               DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt               DateTime               @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  period BillingPeriod? @relation(fields: [periodId], references: [id], onDelete: Restrict)

  @@index([teamId, createdAt(sort: Desc)], map: "payment_operations_team_id_created_at_idx")
  @@map("payment_operations")
}

// The app's Idempotency-Key for creating a payment session, with a fingerprint of the request and the stored answer.
model PaymentRequest {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  teamId             String   @map("team_id") @db.Uuid
  userId             String   @map("user_id") @db.Uuid
  idempotencyKey     String   @map("idempotency_key")
  requestFingerprint String   @map("request_fingerprint")
  operationId        String?  @map("operation_id") @db.Uuid
  responseStatus     Int      @map("response_status")
  response           Json
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@unique([teamId, idempotencyKey], map: "payment_requests_team_id_idempotency_key_key")
  @@map("payment_requests")
}

// THE LEDGER: append-only (triggers reject UPDATE, DELETE and TRUNCATE). Money rows and state rows; the subscription is rebuildable from it.
model LedgerEntry {
  id                    String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  // Write order. Generated by the database; never set by the application.
  position              BigInt          @default(autoincrement())
  teamId                String          @map("team_id") @db.Uuid
  operationId           String          @map("operation_id") @db.Uuid
  entryType             LedgerEntryType @map("entry_type")
  sequence              Int
  amountCents           Int             @map("amount_cents")
  currency              String          @default("usd")
  periodId              String?         @map("period_id") @db.Uuid
  plan                  BillingPlan?
  seats                 Int?
  paidBasisAfterCents   Int?            @map("paid_basis_after_cents")
  stripePaymentIntentId String?         @map("stripe_payment_intent_id")
  createdAt             DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)

  period BillingPeriod? @relation(fields: [periodId], references: [id], onDelete: Restrict)

  @@unique([position], map: "ledger_entries_position_key")
  @@unique([operationId, entryType, sequence], map: "ledger_entries_operation_id_entry_type_sequence_key")
  @@index([teamId, position], map: "ledger_entries_team_id_position_idx")
  @@map("ledger_entries")
}

// The webhook inbox (shard A): one row per Stripe event, unique by event id, written before anything is queued. Only the fields the job needs.
model StripeEvent {
  eventId           String    @id @map("event_id")
  eventType         String    @map("event_type")
  livemode          Boolean
  stripeCreatedAt   DateTime  @map("stripe_created_at") @db.Timestamptz(3)
  checkoutSessionId String?   @map("checkout_session_id")
  paymentIntentId   String?   @map("payment_intent_id")
  teamId            String?   @map("team_id") @db.Uuid
  operationId       String?   @map("operation_id") @db.Uuid
  workRowId         String?   @map("work_row_id") @db.Uuid
  receivedAt        DateTime  @default(now()) @map("received_at") @db.Timestamptz(3)
  processedAt       DateTime? @map("processed_at") @db.Timestamptz(3)
  // applied | duplicate | review | ignored
  outcome           String?

  workRow WorkRow? @relation(fields: [workRowId], references: [id], onDelete: SetNull)

  @@index([paymentIntentId], map: "stripe_events_payment_intent_id_idx")
  @@map("stripe_events")
}
