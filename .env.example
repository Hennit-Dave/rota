# Variable names only, no values. Copy to .env (gitignored) and fill in.
# Each slice adds the names it introduces.

# Read by the API. Optional: defaults to 3000 for local development.
PORT=

# Not read by any code yet. Used by the email job in the infrastructure-proof slice.
RESEND_API_KEY=
MAIL_FROM=
MAIL_REPLY_TO=

# Neon shard A and B (feat/db-shards). Each shard has two connection strings:
# *_DIRECT_URL   unpooled host. Used ONLY by Prisma migrations and the parity check.
# *_DATABASE_URL pooled "-pooler" host. Read by the shard clients in server/src/db/clients.ts and by
#                `npm run db:check-pooled`. The API and worker processes do not import the clients yet.
SHARD_A_DIRECT_URL=
SHARD_A_DATABASE_URL=
SHARD_B_DIRECT_URL=
SHARD_B_DATABASE_URL=

# Aiven for Valkey (feat/queue-worker). Used by BullMQ queue and worker processes.
# Must use rediss:// (TLS required on Aiven) and noeviction policy.
VALKEY_URL=

# Dedicated test database configuration (for running database integration tests and proofs).
# Integration tests require TEST_DATABASE_ALLOWED=true and dedicated test shard URLs.
# Direct URLs are used for applying Prisma migrations to test databases.
# Pooled URLs are used by the test shard clients and proof harnesses.
# Fallback to ordinary application shard URLs is prohibited.
TEST_DATABASE_ALLOWED=
TEST_SHARD_A_DIRECT_URL=
TEST_SHARD_A_DATABASE_URL=
TEST_SHARD_B_DIRECT_URL=
TEST_SHARD_B_DATABASE_URL=

# Reconciliation sweep (feat/reconcile). Both optional: the defaults are 1800000 (30 minutes) and 100.
RECONCILE_INTERVAL_MS=
RECONCILE_BATCH_SIZE=
# Cap on consecutive sweep recoveries of a job that fails before claiming. Optional: defaults to WORK_MAX_ATTEMPTS (5).
WORK_MAX_RECOVERIES=

# Authentication (feat/auth-server). The signing secret has no default and the API refuses to start without it.
# Generate with: openssl rand -base64 32   (must decode to at least 32 bytes; RFC 7518 section 3.2)
AUTH_JWT_SECRET=
# Optional overrides. Defaults (approved 2026-10-21): access 15 minutes, refresh idle 30 days, session 90 days.
AUTH_ACCESS_TOKEN_MINUTES=
AUTH_REFRESH_IDLE_DAYS=
AUTH_SESSION_ABSOLUTE_DAYS=
# How long an auth database transaction may wait to start, in ms. Optional: default 5000 (Prisma's own default is 2000).
AUTH_TRANSACTION_MAX_WAIT_MS=
# Optional rate-limit overrides (positive integers). Defaults are in docs/SECURITY.md.
RATE_LIMIT_LOGIN_IP_MAX=
RATE_LIMIT_LOGIN_IP_WINDOW_SECONDS=
RATE_LIMIT_LOGIN_EMAIL_MAX=
RATE_LIMIT_LOGIN_EMAIL_WINDOW_SECONDS=
RATE_LIMIT_REGISTER_IP_MAX=
RATE_LIMIT_REGISTER_IP_WINDOW_SECONDS=
RATE_LIMIT_REFRESH_IP_MAX=
RATE_LIMIT_REFRESH_IP_WINDOW_SECONDS=
