# Variable names only, no values. Copy to .env (gitignored) and fill in.
# Each slice adds the names it introduces.

# Read by the API. Optional: defaults to 3000 for local development.
PORT=

# Email (ADR 0016). RESEND_API_KEY is a secret and is read ONLY by the worker; the worker refuses to start without it.
# MAIL_FROM and MAIL_REPLY_TO are not secrets: the API freezes them into each email's stored payload and refuses to start without them.
# Sender: `Rota <notification@rota.davebuilds.design>`. Reply-To: `rota@davebuilds.design` (AGENTS.md).
RESEND_API_KEY=
MAIL_FROM=
MAIL_REPLY_TO=

# Neon shard A and B (feat/db-shards). Each shard has two connection strings:
# *_DIRECT_URL   unpooled host. Used ONLY by Prisma migrations and the parity check.
# *_DATABASE_URL pooled "-pooler" host. Read by the shard clients in server/src/db/clients.ts and by
#                `npm run db:check-pooled`. The API and worker processes do not import the clients yet.
SHARD_A_DIRECT_URL=
SHARD_A_DATABASE_URL=
SHARD_B_DIRECT_URL=
SHARD_B_DATABASE_URL=

# Aiven for Valkey (feat/queue-worker). Used by BullMQ queue and worker processes.
# Must use rediss:// (TLS required on Aiven) and noeviction policy.
VALKEY_URL=

# Optional, tests only: path to a local valkey-server binary, for the recovery tests that start their own disposable Valkey
# (valkey-recovery.integration.test.ts). Not needed when valkey-server is on PATH. Never a URL; never the shared instance.
LOCAL_VALKEY_BIN=

# Dedicated test database configuration (for running database integration tests and proofs).
# Integration tests require TEST_DATABASE_ALLOWED=true and dedicated test shard URLs.
# Direct URLs are used for applying Prisma migrations to test databases.
# Pooled URLs are used by the test shard clients and proof harnesses.
# Fallback to ordinary application shard URLs is prohibited.
TEST_DATABASE_ALLOWED=
TEST_SHARD_A_DIRECT_URL=
TEST_SHARD_A_DATABASE_URL=
TEST_SHARD_B_DIRECT_URL=
TEST_SHARD_B_DATABASE_URL=

# Reconciliation sweep (feat/reconcile). Both optional: the defaults are 1800000 (30 minutes) and 100.
RECONCILE_INTERVAL_MS=
RECONCILE_BATCH_SIZE=
# Cap on consecutive sweep recoveries of a job that fails before claiming. Optional: defaults to WORK_MAX_ATTEMPTS (5).
WORK_MAX_RECOVERIES=

# Authentication (feat/auth-server). The signing secret has no default and the API refuses to start without it.
# Generate with: openssl rand -base64 32   (must decode to at least 32 bytes; RFC 7518 section 3.2)
AUTH_JWT_SECRET=
# Optional overrides. Defaults (approved 2026-10-21): access 15 minutes, refresh idle 30 days, session 90 days.
AUTH_ACCESS_TOKEN_MINUTES=
AUTH_REFRESH_IDLE_DAYS=
AUTH_SESSION_ABSOLUTE_DAYS=
# How long an auth database transaction may wait to start, in ms. Optional: default 5000 (Prisma's own default is 2000).
AUTH_TRANSACTION_MAX_WAIT_MS=
# Optional rate-limit overrides (positive integers). Defaults are in docs/SECURITY.md.
RATE_LIMIT_LOGIN_IP_MAX=
RATE_LIMIT_LOGIN_IP_WINDOW_SECONDS=
RATE_LIMIT_LOGIN_EMAIL_MAX=
RATE_LIMIT_LOGIN_EMAIL_WINDOW_SECONDS=
RATE_LIMIT_REGISTER_IP_MAX=
RATE_LIMIT_REGISTER_IP_WINDOW_SECONDS=
RATE_LIMIT_REFRESH_IP_MAX=
RATE_LIMIT_REFRESH_IP_WINDOW_SECONDS=
RATE_LIMIT_TEAM_CREATE_USER_MAX=
RATE_LIMIT_TEAM_CREATE_USER_WINDOW_SECONDS=
RATE_LIMIT_INVITE_SEND_USER_MAX=
RATE_LIMIT_INVITE_SEND_USER_WINDOW_SECONDS=
RATE_LIMIT_INVITE_SEND_TEAM_MAX=
RATE_LIMIT_INVITE_SEND_TEAM_WINDOW_SECONDS=
RATE_LIMIT_INVITE_PREVIEW_IP_MAX=
RATE_LIMIT_INVITE_PREVIEW_IP_WINDOW_SECONDS=
RATE_LIMIT_INVITE_ACCEPT_IP_MAX=
RATE_LIMIT_INVITE_ACCEPT_IP_WINDOW_SECONDS=
RATE_LIMIT_INVITE_ACCEPT_USER_MAX=
RATE_LIMIT_INVITE_ACCEPT_USER_WINDOW_SECONDS=
# Invitations (ADR 0015). Optional; defaults: 7 days, 50 invite emails per UTC day app-wide, and the production link host.
INVITE_EXPIRY_DAYS=
INVITE_GLOBAL_DAILY_CAP=
# The https origin of the App Link host. Must have no path or query.
INVITE_LINK_BASE_URL=
# The one real-email proof recipient: set it ONLY in your local .env, never commit a value. Tests use Resend's test addresses.
PROOF_EMAIL_TO=
# How long one Resend call may take, in ms. Optional: default 10000, well under the 30 s work lease (ADR 0016).
EMAIL_SEND_TIMEOUT_MS=

# Expo app. These go in app/.env (gitignored), NOT the root .env: Expo reads the app folder.
# EXPO_PUBLIC_ values are bundled into the app and readable by anyone who downloads it, so never put a secret here.
# This is the only one, and why it is safe is in docs/SECURITY.md.
# Emulator + local API: http://10.0.2.2:<server PORT>   (10.0.2.2 is how the Android emulator reaches this computer)
# Deployed API: the https address of the deployed server.
EXPO_PUBLIC_API_URL=

# EAS Build only (an EAS file environment variable, not a repo file): the contents of google-services.json for push.
# Local builds read app/google-services.json instead. See docs/decisions/0011.
GOOGLE_SERVICES_JSON=
