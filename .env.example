# Variable names only, no values. Copy to .env (gitignored) and fill in.
# Each slice adds the names it introduces.

# Read by the API. Optional: defaults to 3000 for local development.
PORT=

# Not read by any code yet. Used by the email job in the infrastructure-proof slice.
RESEND_API_KEY=
MAIL_FROM=
MAIL_REPLY_TO=

# Neon shard A and B (feat/db-shards). Each shard has two connection strings:
# *_DIRECT_URL   unpooled host. Used ONLY by Prisma migrations and the parity check.
# *_DATABASE_URL pooled "-pooler" host. Read by the shard clients in server/src/db/clients.ts and by
#                `npm run db:check-pooled`. The API and worker processes do not import the clients yet.
SHARD_A_DIRECT_URL=
SHARD_A_DATABASE_URL=
SHARD_B_DIRECT_URL=
SHARD_B_DATABASE_URL=
